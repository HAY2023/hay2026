# SUPABASE EDGE FUNCTIONS ENVIRONMENT VARIABLES
# Set these in your Supabase Dashboard -> Edge Functions -> Settings

# Your Gemini API Key (starts with AIzaSy)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase URL (already set by default but double check)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (for secure DB access in functions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
